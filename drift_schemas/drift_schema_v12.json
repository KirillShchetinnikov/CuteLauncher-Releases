      ],
      "type": "trigger",
      "data": {
        "on": 1,
        "references_in_body": [
          1,
          0
        ],
        "name": "archive_app_launch_count",
        "sql": "CREATE TRIGGER archive_app_launch_count\nAFTER DELETE ON apps\nWHEN OLD.launch_count > 0\nBEGIN\n  INSERT INTO archived_app_launch_counts (package_name, launch_count)\n  VALUES (OLD.package_name, OLD.launch_count)\n  ON CONFLICT (package_name) DO UPDATE SET launch_count = excluded.launch_count;\nEND;"
      }
    },
    {
      "id": 3,
      "references": [
        1,
        0
      ],
      "type": "trigger",
      "data": {
        "on": 1,
        "references_in_body": [
          1,
          0
        ],
        "name": "recover_app_launch_count",
        "sql": "CREATE TRIGGER recover_app_launch_count\nAFTER INSERT ON apps\nWHEN EXISTS (SELECT 1 FROM archived_app_launch_counts WHERE package_name = NEW.package_name)\nBEGIN\n  UPDATE apps\n  SET launch_count = max(NEW.launch_count, (\n    SELECT launch_count FROM archived_app_launch_counts WHERE package_name = NEW.package_name\n  ))\n  WHERE package_name = NEW.package_name;\n  DELETE FROM archived_app_launch_counts WHERE package_name = NEW.package_name;\nEND;"
      }
    },
